{
  "name": "habit-tracker-akmal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "node backend/src/server.js",
    "build": "vite build",
    "install:all": "cd frontend && npm install && cd ../backend && npm install",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.100.10",
    "bcryptjs": "^3.0.3",
    "typescript": "^6.0.3",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "concurrently": "^9.2.1",
    "vite": "^8.0.4"
  }
}
